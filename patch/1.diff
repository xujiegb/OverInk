+    pub fn set_size(&mut self, w: i32, h: i32) -> Result<(), String> {
+        if self.overlay {
+            return Ok(());
+        }
+        unsafe {
+            let ver = (self.version)(self.layer_surface);
+            (self.marshal)(
+                self.layer_surface,
+                0,
+                ptr::null(),
+                ver,
+                0,
+                w.max(1) as u32,
+                h.max(1) as u32,
+            );
+            (self.marshal)(
+                self.surface,
+                6,
+                ptr::null(),
+                (self.version)(self.surface),
+                0,
+            );
+            if (self.roundtrip)(self.display, self.queue) < 0 || self.state.closed {
+                return Err("Wayland layer surface resize configure failed".into());
+            }
+            Ok(())
+        }
+    }
+
+    pub fn poll(&mut self, raw: *mut SDL_Window, pass: bool) -> Result<bool, String> {
+        unsafe {
+            if (self.dispatch_pending)(self.display, self.queue) < 0 {
+                return Err("Dispatching Wayland layer events failed".into());
+            }
+            if self.state.closed {
+                return Err("Wayland compositor closed the overlay layer surface".into());
+            }
+            let mut committed_kb = false;
+            if self.overlay {
+                let ver = (self.version)(self.layer_surface);
+                let desired = if pass {
+                    0u32
+                } else if ver >= 4 {
+                    2u32
+                } else {
+                    1u32
+                };
+                if self.keyboard_mode != Some(desired) {
+                    (self.marshal)(self.layer_surface, 4, ptr::null(), ver, 0, desired);
+                    self.keyboard_mode = Some(desired);
+                    committed_kb = true;
+                }
+                if self.state.width > 0 && self.state.height > 0 {
+                    let (mut w, mut h) = (0, 0);
+                    SDL_GetWindowSize(raw, &mut w, &mut h);
+                    if w != self.state.width as i32 || h != self.state.height as i32 {
+                        let _ = SDL_SetWindowSize(
+                            raw,
+                            self.state.width as i32,
+                            self.state.height as i32,
+                        );
+                    }
+                }
+            }
+            Ok(committed_kb)
+        }
+    }
+}
