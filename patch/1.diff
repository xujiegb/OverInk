+pub fn has_layer_shell() -> bool {
+    static SUPPORTED: OnceLock&lt;bool&gt; = OnceLock::new();
+    *SUPPORTED.get_or_init(|| unsafe {
+        let Ok(lib) = library(&["libwayland-client.so.0", "libwayland-client.so"]) else {
