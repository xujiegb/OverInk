+        if display.is_null() {
+            return false;
+        }
+        let registry = marshal(
+            display,
+            1,
+            *registry_interface,
+            1,
+            0,
+            ptr::null_mut::<c_void>(),
+        );
+        let mut globals = Box::new(Globals::default());
+        let supported = !registry.is_null()
+            && add_listener(
+                registry,
+                (&LISTENER as *const Listener).cast(),
+                (&mut *globals as *mut Globals).cast(),
+            ) == 0
+            && roundtrip(display) >= 0
+            && globals.layer_shell != 0;
+        if !registry.is_null() {
+            destroy(registry);
+        }
+        disconnect(display);
+        supported
+    })
