+struct LayerState {
+    marshal: Marshal,
+    version: Version,
+    width: u32,
+    height: u32,
+    configured: bool,
+    closed: bool,
+}
+
+unsafe extern "C" fn layer_configure(
+    data: *mut c_void,
+    layer_surface: *mut c_void,
+    serial: u32,
+    width: u32,
+    height: u32,
+) {
+    unsafe {
+        let state = &mut *data.cast::<LayerState>();
+        (state.marshal)(
+            layer_surface,
+            6,
+            ptr::null(),
+            (state.version)(layer_surface),
+            0,
+            serial,
+        );
+        if width > 0 {
+            state.width = width;
+        }
+        if height > 0 {
+            state.height = height;
+        }
+        state.configured = true;
+    }
+}
+
+unsafe extern "C" fn layer_closed(data: *mut c_void, _layer_surface: *mut c_void) {
+    unsafe {
+        let state = &mut *data.cast::<LayerState>();
+        state.closed = true;
+    }
+}
