+            return false;
+        };
+        let Ok(destroy) = lib.get::<Destroy>(b"wl_proxy_destroy\0") else {
+            return false;
+        };
+        let Ok(add_listener) = lib.get::<
+            unsafe extern "C" fn(*mut c_void, *const c_void, *mut c_void) -> c_int,
+        >(b"wl_proxy_add_listener\0") else {
+            return false;
+        };
+        let Ok(roundtrip) =
+            lib.get::<unsafe extern "C" fn(*mut c_void) -> c_int>(b"wl_display_roundtrip\0")
+        else {
+            return false;
+        };
+        let Ok(registry_interface) = lib.get::<*const c_void>(b"wl_registry_interface\0") else {
+            return false;
+        };
