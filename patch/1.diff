+    configure: unsafe extern "C" fn(*mut c_void, *mut c_void, u32, u32, u32),
+    closed: unsafe extern "C" fn(*mut c_void, *mut c_void),
+}
+
+static LAYER_LISTENER: LayerListener = LayerListener {
+    configure: layer_configure,
+    closed: layer_closed,
+};
+
+fn resolve_wl_output(output_id: Option&lt;u32&gt;) -> Result<*mut c_void, String> {
+    let Some(id) = output_id else {
+        return Ok(ptr::null_mut());
+    };
+    if id == 0 {
+        return Err("Invalid display ID 0 for Wayland layer surface".into());
+    }
+    let wl_output = unsafe {
+        SDL_GetPointerProperty(
+            SDL_GetDisplayProperties(SDL_DisplayID(id)),
+            c"SDL.display.wayland.wl_output".as_ptr(),
+            ptr::null_mut(),
+        )
+    };
+    if wl_output.is_null() {
+        return Err(format!(
+            "Display {id} does not expose a Wayland wl_output handle"
+        ));
+    }
+    Ok(wl_output)
+}
