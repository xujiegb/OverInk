+impl Drop for LayerWindow {
+    fn drop(&mut self) {
+        unsafe {
+            if !self.layer_surface.is_null() {
+                (self.marshal)(
+                    self.layer_surface,
+                    7,
+                    ptr::null(),
+                    (self.version)(self.layer_surface),
+                    1,
+                );
+            }
+            if (self.version)(self.layer_shell) >= 3 {
+                (self.marshal)(
+                    self.layer_shell,
+                    1,
+                    ptr::null(),
+                    (self.version)(self.layer_shell),
+                    1,
+                );
+            } else {
+                (self.destroy)(self.layer_shell);
+            }
+            let _ = (self.flush)(self.display);
+            (self.queue_destroy)(self.queue);
+        }
+    }
+}
