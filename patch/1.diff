+pub fn has_layer_shell() -> bool {
+    static SUPPORTED: OnceLock&lt;bool&gt; = OnceLock::new();
+    *SUPPORTED.get_or_init(|| unsafe {
+        let Ok(lib) = library(&["libwayland-client.so.0", "libwayland-client.so"]) else {
+            return false;
+        };
+        let Ok(connect) =
+            lib.get::<unsafe extern "C" fn(*const c_char) -> *mut c_void>(b"wl_display_connect\0")
+        else {
+            return false;
+        };
+        let Ok(disconnect) = lib.get::<Destroy>(b"wl_display_disconnect\0") else {
+            return false;
+        };
+        let Ok(marshal) = lib.get::<Marshal>(b"wl_proxy_marshal_flags\0") else {
+            return false;
+        };
+        let Ok(destroy) = lib.get::<Destroy>(b"wl_proxy_destroy\0") else {
+            return false;
+        };
+        let Ok(add_listener) = lib.get::<
+            unsafe extern "C" fn(*mut c_void, *const c_void, *mut c_void) -> c_int,
+        >(b"wl_proxy_add_listener\0") else {
+            return false;
+        };
+        let Ok(roundtrip) =
+            lib.get::<unsafe extern "C" fn(*mut c_void) -> c_int>(b"wl_display_roundtrip\0")
+        else {
+            return false;
+        };
+        let Ok(registry_interface) = lib.get::<*const c_void>(b"wl_registry_interface\0") else {
+            return false;
+        };
+        let display = connect(ptr::null());
+        if display.is_null() {
+            return false;
+        }
+        let registry = marshal(
+            display,
+            1,
+            *registry_interface,
+            1,
+            0,
+            ptr::null_mut::<c_void>(),
+        );
+        let mut globals = Box::new(Globals::default());
+        let supported = !registry.is_null()
+            && add_listener(
+                registry,
+                (&LISTENER as *const Listener).cast(),
+                (&mut *globals as *mut Globals).cast(),
+            ) == 0
+            && roundtrip(display) >= 0
+            && globals.layer_shell != 0;
+        if !registry.is_null() {
+            destroy(registry);
+        }
+        disconnect(display);
+        supported
+    })
+}
